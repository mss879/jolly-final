# Supabase — Project Settings → API Keys.
# The publishable key is safe in the browser; Row Level Security protects the data.
# (A legacy "anon" key works in the same slot.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only secret key (Project Settings → API Keys → Secret keys). The
# contact and reserve form endpoints use it, which lets migration
# 20261016120000 close those functions to direct browser calls. Never give it
# a NEXT_PUBLIC_ name. Set it here and on the host BEFORE applying that
# migration.
SUPABASE_SECRET_KEY=

# The live address (canonical links, sitemap, robots.txt, structured data).
# Defaults to https://www.jollyscreamery.com; set only for a staging copy.
NEXT_PUBLIC_SITE_URL=
# Search engines index only the production deployment. Vercel previews are
# blocked automatically; on another host set SITE_INDEXING=off for staging.
SITE_INDEXING=

# AI chat concierge (the chat button on the website). Server-only: never give
# these a NEXT_PUBLIC_ name. Without a key the chat still saves every message
# and hands each conversation to the team in /admin/chats.
OPENAI_API_KEY=
# Optional. The OpenAI model the concierge uses; defaults to gpt-5.4-mini.
OPENAI_MODEL=
