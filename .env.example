# Supabase — Project Settings → API Keys.
# The publishable key is safe in the browser; Row Level Security protects the data.
# (A legacy "anon" key works in the same slot.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google reviews (Reviews page and Home). Two ways — the widget wins if both are set.
# Without either, the pages show the built-in placeholder reviews.
#
# 1) Featurable widget (free, no Google billing): featurable.com → sign in →
#    Create Widget → choose the listing → API tab → copy the Featurable ID.
FEATURABLE_WIDGET_ID=
# 2) Google's Places API (New), server-side only. Google Cloud console → enable
#    "Places API (New)" → create an API key, restrict it to that API, and turn
#    on billing.
GOOGLE_PLACES_API_KEY=
# Optional. The listing is already set in src/lib/google-reviews.ts
# ("Jolly's Creamery Corporate office", Colombo 5); set this only to use another.
GOOGLE_PLACE_ID=
