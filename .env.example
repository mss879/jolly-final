# Supabase — Project Settings → API Keys.
# The publishable key is safe in the browser; Row Level Security protects the data.
# (A legacy "anon" key works in the same slot.)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Google reviews (Reviews page and Home) — Places API (New), server-side only.
# Google Cloud console → enable "Places API (New)" → create an API key, restrict
# it to that API, and turn on billing. Find the listing's Place ID with
# https://developers.google.com/maps/documentation/places/web-service/place-id
# Without these, the pages show the built-in placeholder reviews.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=
